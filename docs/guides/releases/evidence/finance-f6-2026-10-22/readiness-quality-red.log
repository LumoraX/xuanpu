    async def test_archive_profile_matches_domain_eligibility(store: Any, changes: dict[str, Any]) -> None:
        """准备检查不得把领域明确拒绝的档案profile标为模拟可用。"""
        from xuanpu_finance.compliance.models import CompliancePolicy
        from xuanpu_finance.storage.common import decode
        payer=await fully_configured(store)
        first=await store.get_finance_readiness(payer,'e')
        assert first['status']=='configured_simulation'
        raw=decode(await store.pool.fetchval("SELECT r.data FROM finance_compliance_policy p JOIN finance_compliance_policy_revision r USING(tenant_id,legal_entity_id,version) WHERE p.tenant_id='t' AND p.legal_entity_id='e'"))
        raw.update(version=raw['version']+1,enabled=True,**changes)
        providers=[{**decode(row['data']),'enabled':row['enabled']} for row in await store.pool.fetch("SELECT data,enabled FROM finance_compliance_provider WHERE tenant_id='t' AND legal_entity_id='e'")]
        await store.configure_compliance([CompliancePolicy.model_validate(raw)],providers,simulation=True)
        report=await store.get_finance_readiness(payer,'e')
