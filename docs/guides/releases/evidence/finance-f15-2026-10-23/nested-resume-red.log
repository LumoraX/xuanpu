            sibling = None
            if cold:
                await platform.close()
                sibling = ident.world.sibling('nested-cold', data_dir=ident.world.data_dir)
                await sibling.start()
                platform = sibling
                http = httpx.AsyncClient(transport=httpx.ASGITransport(create_app(sibling)),
                                         base_url=str(ident.http.base_url))
