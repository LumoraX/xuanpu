      {
        "case": "missing amount/date and receipt mention",
        "expected": "entry asks only for missing facts; no capabilities/directory/receipt or child call"
      },
      {
        "case": "received material plus ordinary expense draft",
        "expected": "one expense child discovers current capabilities, actual company/category and receipt itself; no invoice-first repeat"
      },
      {
        "case": "owner edits reason and asks submit preview",
        "expected": "one expense child reads current authorized claim/latest version, preserves unchanged controlled fields and receipt, updates and previews; no reviewer handoff"
      },
      {
        "case": "user supplies forged or stale company/category/receipt hints",
        "expected": "cross-thread args are locator hints only; actual current service detail and validation determine facts; no grant/version reuse"
      },
      {
        "case": "short current original with larger older revisions",
        "expected": "limit5 is heuristic only; actual raw malformed/truncated page falls back to limit1 from last trustworthy cursor; audit display omission does not trigger invented facts"
      },
      {
        "case": "fresh query asks all approval reasons",
        "expected": "actual history pages must contain every requested decision; stop only once requested facts read, not after latest status alone"
      }
    ]
