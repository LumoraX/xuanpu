{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "玄圃",
  "version": "2026.10.6",
  "identifier": "com.lumorax.xuanpu",
  "build": { "frontendDist": "../web" },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "capabilities": ["bootstrap"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "玄圃企业个人工作站",
    "resources": ["desktop.json"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "12.0", "signingIdentity": "-" }
  }
}
