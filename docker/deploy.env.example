# 部署者本机的服务器信息模板。复制为 docker/deploy.env 后填写；deploy.env 已被 .gitignore 忽略，不进仓库。
# 与 docker/.env 分开：.env 会随 Compose 上传到服务器并进入备份，本文件只留在部署者本机。
# 发布记录（docs/guides/releases/）里的 <服务器>、<服务器IP>、<正式入口>、<服务器数据目录>、<镜像仓库> 等占位符，
# 实际值都以这里（镜像仓库以 docker/.env 的 IMAGE）为准。

# ~/.ssh/config 里的主机别名，对应文档中的 <服务器>。
DEPLOY_HOST=my-server

# 服务器公网 IP，对应 <服务器IP>。
DEPLOY_SERVER_IP=203.0.113.10

# 正式入口，对应 <正式入口>（发布记录中以 xuanpu.example.com 表示）。
DEPLOY_PUBLIC_URL=https://xuanpu.example.com/console/

# 服务器上的部署与数据根目录，对应 <部署目录> / <服务器数据目录>。
DEPLOY_SERVER_DIR=/srv/xuanpu

# 同一宿主上其他需要一起核对健康的服务入口（空格分隔，可留空）。
DEPLOY_SHARED_HOST_URLS=
