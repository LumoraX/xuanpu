# 本地开发用的真实模型配置模板。复制为仓库根目录的 .env 后填写；.env 已被 .gitignore 忽略，不进仓库。
# 只给本机开发、真实模型测试与 R5 验收脚本用；平台进程本身不读这个文件，
# 由启动命令把这些值映射成配置文件里的 ${MODEL_GATEWAY_URL} 等变量。
# 桌面客户端不用这个文件。

# 协议：chat、responses 或 codex_responses
LLM_BOOTSTRAP_PROTOCOL=chat
# 任何兼容 OpenAI 接口的网关地址，以 /v1 结尾
LLM_BOOTSTRAP_BASE_URL=
LLM_BOOTSTRAP_API_KEY=
# 模型名（fast、balanced、deep 三档都用它）
LLM_BOOTSTRAP_MODEL=
